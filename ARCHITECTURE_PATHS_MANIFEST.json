    "main_layout": "src/components/MainLayout.tsx",
    "academic_types": "src/types/academic.ts",
    "course_ise232_chapters": "src/data/courses/ise232-programs/chapters.ts",
    "academic_container": "src/components/academic/AcademicModeContainer.tsx",
    "interactive_3d_book": "src/components/interactive/Interactive3DBookEngine.tsx",
    "certificate_preview": "src/components/ui/CertificatePreview.tsx",
