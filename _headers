/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com; connect-src 'self' https: wss:;
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/index.html
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0
/version.json
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0
